<odoo>
    <data>
        <!-- department form veiw -->
        <record id="department_form_view" model="ir.ui.view">
            <field name="name">student.department.form</field>
            <field name="model">student.department</field>
            <field name="arch" type="xml">
                <form string="Department">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(souban_second_module.action_student_registration)d"
                                type="action" class="oe_stat_button" icon="fa-users"
                                context="{'search_default_department_groups': 1, 'default_department_id': id}">
                                <field name="student_count" widget="statinfo" string="Students" />
                            </button>
                            <button name="%(souban_second_module.action_subject_subject)d"
                                context="{'search_default_subjects_groups': 1, 'default_department_id': id}"
                                type="action" class="oe_stat_button" icon="fa-book">
                                <field name="subject_count" widget="statinfo" string="Subjects" />
                            </button>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                            <field name="student_count" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Students">
                                <field name="student_ids"/>
                            </page>
                            <page string="Subjects">
                                <field name="subject_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- department list view -->
         
        <record id="department_list_view" model="ir.ui.view">
            <field name="name">student.department.list</field>
            <field name="model">student.department</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="student_count"/>
                </list>
            </field>
        </record>

        <record id="action_department_department" model="ir.actions.act_window">
            <field name="name">Departments</field>
            <field name="res_model">student.department</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_department_root" name="Departments" parent="student_registration_menu_root" action="action_department_department" sequence="2"/>
    </data>
</odoo>
