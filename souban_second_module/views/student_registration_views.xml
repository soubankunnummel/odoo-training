<odoo>
    <data>
        <!-- Form View -->
        <record id="student_registration_form_view" model="ir.ui.view">
            <field name="name">student.registration.form</field>
            <field name="model">student.registration</field>
            <field name="arch" type="xml">
                <form string="Student Registration">
                    <header>
                        <button name="action_confirm" invisible="state == 'confirmed' "
                            string="Confirm" type="object" class="btn-primary" />
                        <button name="action_set_draft" invisible="state == 'draft' "
                            string="Set to Draft" type="object" />
                        <button name="action_complete" invisible="state == 'completed' "
                            string="Done" type="object" />

                        <button name="%(souban_second_module.action_department_department)d"
                            string="Departments" type="action" class="btn-secondary" />
                        <button name="%(souban_second_module.action_subject_subject)d"
                            string="Subjects" type="action" class="btn-secondary" />
                        <button name="action_deactivate"
                            string="Deactivate"
                            type="object"
                            class="btn-secondary"
                            invisible="not active" />
                        <button name="%(souban_second_module.action_student_update_wizard)d"
                            string="Update Student" type="action" class="btn-secondary" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_classmates" type="object"
                                class="oe_stat_button" icon="fa-user-friends"
                                invisible="not department_id">
                                <field name="classmate_count" widget="statinfo" string="Classmates" />
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="student_code" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="student_code" readonly="1" />
                                <field name="age" />
                                <field name="email" />
                                <field name="user_id" />
                                <field name="user_email" />
                                <field name="user_name" />
                            </group>
                            <group>

                                <field name="gender" />
                                <field name="department_id" />
                                <field name="subject_ids" widget="many2many_tags" />
                                <field name="subject_department_code" />
                                <field name="guardian_id" />
                                <field name="guardian_name" />
                                <field name="guardian_email" />
                                <field name="guardian_phone" />
                                <field name="photo" widget="image" class="oe_avatar" />
                            </group>
                        </group>
                        <notebook>
                            <page string="More Info">
                                <group>
                                    <field name="register_date" />
                                    <field name="notes" />
                                    <field name="active" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->

        <record id="student_registration_list_view" model="ir.ui.view">
            <field name="name">student.registration.list</field>
            <field name="model">student.registration</field>
            <field name="arch" type="xml">
                <list>
                    <field name="student_code" />
                    <field name="name" />
                    <field name="age" />
                    <field name="gender" />
                    <field name="department_id" />
                    <field name="subject_department_code" />
                    <field name="guardian_id" />
                    <field name="guardian_phone" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <!-- Search View -->

        <record id="student_registration_search_view" model="ir.ui.view">
            <field name="name">student.registration.search</field>
            <field name="model">student.registration</field>
            <field name="arch" type="xml">
                <search string="Students">
                    <field name="name" />
                    <field name="student_code" />
                    <field name="department_id" />
                    <filter name="draft_students" string="Draft" domain="[('state', '=', 'draft')]" />
                    <filter name="department_groups" string="Group By Department"
                        context="{'group_by': 'department_id'}" />
                    <filter name="confirmed_students" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]" />
                    <filter name="deactivated_students" string="Deactivated"
                        domain="[('active', '=', False)]" />
                </search>
            </field>
        </record>

        <!-- Kanban View -->

        <record id="student_registration_kanban_view" model="ir.ui.view">
            <field name="name">student.registration.kanban</field>
            <field name="model">student.registration</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name" />
                    <field name="photo" />
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <div class="text-center">
                                    <field name="photo" widget="image" class="oe_avatar" />
                                </div>
                                <strong>
                                    <field name="name" />
                                </strong>
                                <br />
                                <span>
                                    <field name="department_id" />
                                </span>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Calender View -->

        <record id="student_registration_calendar_view" model="ir.ui.view">
            <field name="name">student.registration.calendar</field>
            <field name="model">student.registration</field>
            <field name="arch" type="xml">
                <calendar string="Students" date_start="register_date" color="state">
                    <field name="name" />
                    <field name="department_id" />
                </calendar>
            </field>
        </record>

        <record id="action_student_registration" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">student.registration</field>
            <field name="view_mode">list,kanban,form,calendar</field>
        </record>

        <!-- Server Action: Bulk Confirm Draft Students -->
        <record id="action_bulk_confirm_draft" model="ir.actions.server">
            <field name="name">Confirm Selected Draft Students</field>
            <field name="model_id" ref="model_student_registration" />
            <field name="binding_model_id" ref="model_student_registration" />
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_bulk_confirm_draft()</field>
        </record>
        <!-- Server Action: Bulk Draft  Students -->
        <record id="action_bulk_draft_confirm" model="ir.actions.server">
            <field name="name">Confirm to Draft </field>
            <field name="model_id" ref="model_student_registration" />
            <field name="binding_model_id" ref="model_student_registration" />
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_bulk_draft_confirm()</field>
        </record>

        <record id="student_chnage_department" model="ir.actions.server">
            <field name="name">Change Department</field>
            <field name="model_id" ref="model_student_registration" />
            <field name="binding_model_id" ref="model_student_registration" />
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = records.action_change_department()</field>
        </record>

        <menuitem id="student_registration_menu_root" name="Student Registration" sequence="1" />
        <menuitem id="student_registration_menu" name="Students"
            parent="student_registration_menu_root" action="action_student_registration"
            sequence="1" />
    </data>
</odoo>