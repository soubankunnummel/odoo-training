<odoo>
    <data>
        <record id="subject_form_view" model="ir.ui.view">
            <field name="name">student.subject.form</field>
            <field name="model">student.subject</field>
            <field name="arch" type="xml">
                <form string="Subject">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="credits"/>
                            <field name="department_id"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="subject_list_view" model="ir.ui.view">
            <field name="name">student.subject.list</field>
            <field name="model">student.subject</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="credits"/>
                    <field name="department_id"/>
                </list>
            </field>
        </record>

        <record id="action_subject_subject" model="ir.actions.act_window">
            <field name="name">Subjects</field>
            <field name="res_model">student.subject</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_subject_root" name="Subjects" parent="student_registration_menu_root" action="action_subject_subject" sequence="3"/>
    </data>
</odoo>
