<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_student_welcome" model="mail.template">
            <field name="name">Student Welcome Email</field>
            <field name="model_id" ref="model_student_registration" />
            <field name="subject">Welcome {{ object.name }} - Registration Complete</field>
            <field name="email_from">odoo.dev02@sapcomarsha.com</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <h2 style="color: #875A7B;">Welcome, <t t-out="object.name" />!</h2>
                    <p>Your registration has been completed successfully.</p>

                    <table style="width: 100%; border-collapse: collapse; margin: 15px 0;">
                        <tr style="background-color: #f0f0f0;">
                            <td style="padding: 10px; font-weight: bold;">Student Code</td>
                            <td style="padding: 10px;" t-out="object.student_code" />
                        </tr>
                        <tr>
                            <td style="padding: 10px; font-weight: bold;">Department</td>
                            <td style="padding: 10px;" t-out="object.department_id.name" />
                        </tr>
                        <tr style="background-color: #f0f0f0;">
                            <td style="padding: 10px; font-weight: bold;">Register Date</td>
                            <td style="padding: 10px;" t-out="object.register_date" />
                        </tr>
                    </table>

                    <h3 style="color: #875A7B;">Your Department Subjects:</h3>
                    <ul>
                        <t t-foreach="object.department_id.subject_ids" t-as="subject">
                            <li t-out="subject.name" />
                        </t>
                    </ul>

                    <p style="margin-top: 20px;">Best regards,<br />
                    <strong>Student Management Team</strong></p>
                </div>
            </field>
            <!-- <field name="auto_delete" eval="True"/> -->
        </record>

        <!-- Completoin Reminder mail -->

        <record id="email_template_completion_reminder" model="mail.template">
            <field name="name">Completion Reminder</field>
            <field name="model_id" ref="model_student_registration" />
            <field name="subject">Reminder: Complete Your Registration - {{ object.name }}</field>
            <field name="email_from">odoo.dev02@sapcomarsha.com</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <h2 style="color: #875A7B;">Registration Reminder</h2>
                    <p>Dear <t t-out="object.name" />,</p>
                    <p>Your registration is still in <strong>Confirmed</strong> state. Please
                        complete your registration soon.</p>
                    <p>Student Code: <t t-out="object.student_code" /></p>
                    <p>Department: <t t-out="object.department_id.name" /></p>
                    <p>Best regards,<br />Student Management Team</p>
                </div>
            </field>
            <!-- <field name="auto_delete" eval="True" /> -->
        </record>

        <!-- Completoin Reminder mail -->

    </data>
</odoo>