<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_report_wizard_form_view" model="ir.ui.view">
        <field name="name">student.report.wizard.form</field>
        <field name="model">student.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Student Report Wizard">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="department_id"/>
                        <field name="state"/>
                        <field name="report_format"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" type="object"
                        string="Generate Report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_student_report_wizard" model="ir.actions.act_window">
        <field name="name">Student Report</field>
        <field name="res_model">student.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>