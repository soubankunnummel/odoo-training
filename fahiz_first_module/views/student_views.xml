<odoo>
	<data>
        ###form view
		<record id="student_model_form_view" model="ir.ui.view">
			<field name="name">student.model.form</field>
			<field name="model">student.one</field>
			<field name="arch" type="xml">
			<form>
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'confirm'"/>
                            
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state == 'cancel'"/>

                    <button name="action_done"
                            string="Done"
                            type="object"
                            class="btn-success"
                            invisible="state == 'done'"/>
                    
                    <button name="action_draft"
                            string="Set to Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>

                    <button name="%(fahiz_first_module.action_department_one)d"
                                  type="action"
                                  string="Departments"
                                  class="btn-info"/>

                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
				<group>
                    <group>
					<field name="name"/>
                    <field name = "description"/>
                    <field name = "age"/>
                    <field name = "marks"/>
                    <field name = "ce_marks"/>
                    <field name = "total_marks"/>
                    <field name = "dob"/> 

                </group>
                <group>
                    <field name = "gender"/>
                    <field name = "image"/>
                    <field name = "document"/>
                    <field name = "document_name"/>
                    <field name=  "department_id" options="{'no_create': True, 'no_edit': True}"/>
                    <field name=  "user_id" options="{'no_create': True, 'no_edit': True}"/>
                    <field name=  "certification_ids" widget="many2many_tags"/>
                    <field name=  "expiry_date" /> 
                    <field name=  "is_expired" widget = "boolean" readonly="0"/> 
                </group>    
				</group>
                </sheet>
			</form>
			</field>
		</record>

        ###list view
    <record id="student_model_list_view" model="ir.ui.view">
    <field name="name">student.model.list</field>
    <field name="model">student.one</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="age"/>
            <field name="marks"/>
            <field name="dob"/>
        </list>
    </field>
</record>

    <!-- student model search view -->
        <record id ="student_model_search_view" model = "ir.ui.view">
        <field name="name">student.model.search</field>
        <field name="model">student.one</field>
        <field name="arch" type = "xml">
            <search>
                <!-- search fields -->
                 <field name="name" />
                 <field name="age" />
                 <field name="marks"/>

                 <filter string ="Age less than 18" 
                 name="age_minor" 
                 domain="[('age', '&lt;', 18)]"/>

                 <filter string ="Age 18 - 30 " 
                 name="age_18_30" 
                 domain="[('age', '&gt;=', 18),('age', '&lt;=', 30)]"/>

                 <filter string ="Age > 30 " 
                 name="age_above_30" 
                 domain="[('age', '&gt;=', 30)]"/>

                 

                 <group>
                    <filter string = "Age"
                    name="group_by_age" 
                    context="{'group_by':'age'}"/>
                    
                 </group>

            </search>
        </field>
    </record>

        ###kanban view
    <record id="student_model_kanban_view" model="ir.ui.view">
    <field name="name">student.model.kanban</field>
    <field name="model">student.one</field>
    <field name="arch" type="xml">
        <kanban>
            <templates>
                <t t-name="card">
                    <div>
                        <strong>
                            <field name="name"/>
                        </strong>
                        <br/>
                        Age:
                        <field name="age"/>
                        <br/>
                        Marks:
                        <field name="marks"/>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

        ###calendar view

    <record id="student_model_calendar_view" model="ir.ui.view">
    <field name="name">student.model.calendar</field>
    <field name="model">student.one</field>
    <field name="arch" type="xml">
        <calendar string="Student Calendar"
                  date_start="dob">
            <field name="name"/>
        </calendar>
    </field>
</record>
        
<!-- action -->

		 <record id="action_student_one" model="ir.actions.act_window">
			<field name="name">Student</field>
			<field name="res_model">student.one</field>
			<field name="view_mode">list,kanban,calendar,form,search</field>
		</record>
		
		<menuitem name="Students"
		id="student_menu_root"
		sequence="1" /> 
		
	<menuitem 
        name="Student"
		id="menu_student_one"
		parent="student_menu_root"
		action="action_student_one"
		sequence="1" />  
	</data>
</odoo>