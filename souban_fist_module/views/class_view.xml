<odoo>
    <data>

        <record id="class_model_view_form" model="ir.ui.view">
            <field name="name">class.model.form.view</field>
            <field name="model">student.class</field>
            <field name="arch" type="xml">
                <form string="Class Form">
                    <sheet>
                        <group>
                            <field name="name" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_class_model" model="ir.actions.act_window">
            <field name="name">Class Model</field>
            <field name="res_model">student.class</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>


</odoo>