<odoo>
    <data>

        <record id="student_class_view_form" model="ir.ui.view">
            <field name="name">student.class.form.view</field>
            <field name="model">student.class</field>
            <field name="arch" type="xml">
                <form string="Class Form">
                    <sheet>
                        <group>
                            <field name="name" required="1" title="Class Name" />
                            <field name="code" title="Class Code" placeholder="eg: CLASS-10A" />
                            <field name="section" placeholder='eg: A, B, C' />
                            <field name="academic_year" />
                            <!-- <field name="teacher_id" title="Select you Teachers" /> -->
                            <field name="active" />

                        </group>

                        <notebook>
                            <page string="Students">
                                <field name="student_ids"/>
                            </page>
                            <page string="Subjects">
                                <field 
                                widget="many2many_tags"
                                        options="{'no_create': True, 'no_create_edit': True}"
                                name="subject_ids"/>
                                      

                            </page>
                        </notebook>
                    </sheet>

                </form>
            </field>
        </record>

        <record id="action_class_model" model="ir.actions.act_window">
            <field name="name">Class Model</field>
            <field name="res_model">student.class</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="menu_class"
            name="Class"
            action="action_class_model"
            parent="student_menu_root"
            sequence="4"/>


    </data>


</odoo>