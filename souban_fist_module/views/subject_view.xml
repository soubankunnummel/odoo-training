<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="subjects_form_view" model="ir.ui.view">
            <field name="name">subjects.form.view</field>
            <field name="model">student.subjects</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="name" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="subject_actoin" model="ir.actions.act_window">
            <field name="name">Subjects</field>
            <field name="res_model">student.subjects</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem
            id="menu_subjects"
            name="Subjects"
            parent="student_menu_root"
            action="subject_actoin"
            sequence="3" />

    </data>


</odoo>