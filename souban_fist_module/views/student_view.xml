<odoo>

    <data>

        <record id="action_student_calendar"
            model="ir.actions.act_window">
            <field name="name">Student Calendar</field>
            <field name="res_model">student.student</field>
            <field name="view_mode">calendar</field>
        </record>

        <!-- Form View -->
        <record id="student_model_form_view" model="ir.ui.view">
            <field name="name">student.model.form</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <form>
                    <header>

                        <button name="action_status_draft"
                            string="Draft"
                            type="object"
                            invisible="state == 'draft' " />

                        <button name="action_status_progres"
                            string="In Progres"
                            type="object"
                            invisible="state == 'progress'" />

                        <button name="action_status_done"
                            string="Done"
                            type="object"
                            invisible="state == 'done' " />


                        <button
                            name="%(souban_fist_module.action_class_model)d"
                            string="Class"
                            type="action" />
                        <field name="state" widget="statusbar" />
                    </header>

                    <sheet>
                        <group name="from_parent_grp" string="form_parent">

                            <group>
                                <group>
                                    <field name="name" />
                                    <field name="age" />
                                    <field name="gender" />
                                </group>

                                <group>
                                    <field name="marks" />
                                    <field name="grade" readonly="1" />
                                    <field name="is_active" />
                                </group>
                            </group>
                            <group name="image_grop" string="string">
                                <field name="image" widget="image" class="oe_avathar" />

                            </group>


                        </group>
                        <notebook>
                            <page string="Academic Information">
                                <group>
                                    <field name="student_class_id"
                                        options="{'no_create': True, 'no_create_edit': True}" />
                                    <field name="teachers_id"
                                        widget="many2many_tags"
                                        options="{'no_create': True, 'no_create_edit': True}" />
                                </group>
                                <group>
                                    <field name="subject_ids"
                                        widget="many2many_tags"
                                        options="{'no_create': True, 'no_create_edit': True}" />
                                    <field name="advisor_id" />
                                </group>
                            </page>
                            <page name="Basic Info" string="Notes">
                                <group>
                                    <field name="description" help="Enter student description" />
                                    <field name="bio_html" help="Enter student bio" />
                                    <field name="date_of_birth" help="Enter student date of birth" />
                                    <field name="register_time" help="Enter student register time" />
                                </group>
                            </page>
                            <page name="Documents" string="string">
                                <field name="document_name" help="Enter document name" />
                                <field name="document" filename="document_name" />
                            </page>
                        </notebook>

                    </sheet>

                </form>
            </field>
        </record>

        <!-- Form View -->

        <!-- Lisv View -->

        <record
            id="student_list_view" model="ir.ui.view">
            <field name="name">student.list</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="age" />
                    <field name="marks" />
                    <field name="gender" />
                    <field name="is_active" />
                    <button name="action_open_popup" title='see details' type='object' icon='fa-eye' />
                </list>
            </field>
        </record>

        <!-- Lisv View -->

        <!-- Kan ban View -->

        <record
            id="student_Kanban_view" model="ir.ui.view">
            <field name="name">student.kanban</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="state" />
                    <field name="name" />
                    <field name="age" />
                    <field name="marks" />
                    <field name="image" />
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <div class="text-center">
                                    <field name="image" widget="image" />

                                </div>
                                        <strong>
                                    <field name="name" />
                                </strong>
                                        <br />
                                Age: <field name="age" />
                                        <br /> Marks: <field name="marks" />

                            </div>

                        </t>
                    </templates>
                </kanban>
            </field>

        </record>

        <!-- Can ban View -->

        <!-- Serch -->

        <record
            id="student_view_search" model="ir.ui.view">
            <field name="name">student.view.search</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name" />
                    <field name="age" />
                    <filter name="male" string="Male" domain="[('gender', '=', 'male')]"
                    />
                    <filter name="female" string="Female" domain="[('gender', '=', 'female')]" />
                    <filter name="Age above 50" domain="[('age','>',50)]" />
                    <filter name="Mens Grp" context="{'group_by':'gender'}" />
                    <filter name="Active Studnets" domain="[('is_active', '=', True)]" />
                </search>
            </field>
        </record>

        <!-- Serch -->

        <!-- calender view -->

        <record
            id="student_model_view_calendar" model="ir.ui.view">
            <field name="name">student.model.view.calendar</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <calendar string="Sudents" date_start="register_time" color="gender">
                    <field name="name" />
                    <field name="gender" />
                    <field name="marks" />
                </calendar>
            </field>
        </record>

        <!-- calender view -->

        <!-- pivot -->

        <record
            id="student_model_view_pivot" model="ir.ui.view">
            <field name="name">student.model.view.pivot</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <pivot string="Student Analysis">
                    <field name="student_class_id" type="row" />
                    <field name="gender" type="row" />
                    <field name="marks" type="measure" />

                </pivot>
            </field>
        </record>

        <!-- pivot -->

        <!-- pop up view -->

        <record
            id="student_form_popup_view" model="ir.ui.view">
            <field name="name">Student.from.popup</field>
            <field name="model">student.student</field>
            <field name="priority">99</field>
            <field name="arch" type='xml'>
                <form string="Student" create='false' edit="false">
                    <header>
                        <button name="action_edit_student"
                            string="Edit"
                            type="object"
                            class="btn-primary" />
                    </header>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="age" />
                            <field name="marks" />
                            <field name="gender" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- pop up view -->


        <record
            id="student_popup_action"
            model="ir.actions.act_window">
            <field name="name">Student Details</field>
            <field name="res_model">student.student</field>
            <field name="view_mode">form</field>
            <field name="view_id"
                ref="student_form_popup_view" />
            <field name="target">new</field>
        </record>


        <record
            id="action_student_student" model="ir.actions.act_window">
            <field name="name">Student</field>
            <field name="res_model">student.student</field>
            <field name="view_mode">list,kanban,form,calendar,pivot</field>

        </record>

        <menuitem
            name="Students"
            id="student_menu_root"
            sequence="1" />
        <menuitem
            id="menu_student_student"
            name="Student"
            parent="student_menu_root"
            action="action_student_student"
            sequence="1" />

    </data>
</odoo>