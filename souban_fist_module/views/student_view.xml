<odoo>

    <data>

       <!-- Form View -->
         <record id="student_model_form_view" model="ir.ui.view">
            <field name="name">student.model.form</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <form>

                    <sheet>
                        <group name="from_parent_grp" string="form_parent">

                            <group>
                                <field name="name" />
                                <field name="age" />
                                <field name="marks" />
                                <field name="gender" />
                                <field name="is_active" />
                                <field name="student_class" />

                            </group>
                            <group name="image_grop" string="string">
                                <field name="image" widget="image" class="oe_avathar" />

                            </group>


                        </group>
                        <notebook>
                            <page name="Basic Info" string="string">
                                <group>
                                    <field name="description" />
                                    <field name="bio_html" />
                                    <field name="date_of_birth" />
                                    <field name="register_time" />
                                </group>
                            </page>
                            <page name="Documents" string="string">
                                <field name="document_name" />
                                <field name="document" filename="document_name" />
                            </page>
                        </notebook>

                    </sheet>

                </form>
            </field>
        </record>

        <!-- Form View -->

        <!-- Lisv View -->

        <record id="student_list_view" model="ir.ui.view">
            <field name="name">student.list</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="age" />
                    <field name="marks" />
                    <field name="gender" />
                    <field name="is_active" />
                </list>
            </field>
        </record>

        <!-- Lisv View -->

        <!-- Kan ban View -->

        <record id="student_Kanban_view" model="ir.ui.view">
            <field name="name">student.kanban</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <div class="text-center">
                                    <field name="image" widget="image" />

                                </div>
                                        <strong>
                                    <field name="name" />
                                </strong>
                                        <br />
                                Age: <field name="age" />
                                        <br /> Marks: <field name="marks" />

                            </div>

                        </t>
                    </templates>
                </kanban>
            </field>

        </record>

        <!-- Can ban View -->

        <!-- Serch -->

        <record id="student_view_search" model="ir.ui.view">
            <field name="name">student.view.search</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name" />
                    <filter name="male" string="Male" domain="[('gender', '=', 'male')]"
                         />
                    <filter name="female" string="Female" domain="[('gender', '=', 'female')]" />

                </search>
            </field>
        </record>

        <!-- Serch -->

        <!-- calender view -->
         
        <record id="student_model_view_calendar" model="ir.ui.view">
            <field name="name">student.model.view.calendar</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <calendar string="Sudents" date_start="register_time" color="gender">
                    <field name="name" />
                    <field name="gender" />
                    <field name="marks" />
                </calendar>
            </field>
        </record>

        <!-- calender view -->     
         
        <!-- pivot -->

        <record id="student_model_view_pivot" model="ir.ui.view">
            <field name="name">student.model.view.pivot</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <pivot string="Student Analysis" >
                    <field name="student_class" type="row"/>
                    <field name="gender" type="row"/>
                    <field name="marks" type="measure" />
                    
                </pivot>
            </field>
        </record>
        


        <record id="action_student_student" model="ir.actions.act_window">
            <field name="name">Studnet</field>
            <field name="res_model">student.student</field>
            <field name="view_mode">list,kanban,form,calendar,pivot</field>

        </record>

        <menuitem
            name="Students"
            id="student_menu_root"
            sequence="1" />
        <menuitem
            id="menu_student_student"
            name="Student"
            parent="student_menu_root"
            action="action_student_student"
            sequence="1" />

    </data>


</odoo>